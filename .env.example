APP_NAME=CertiCars
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Warsaw
APP_URL=http://localhost

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite

SESSION_DRIVER=cookie
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync

# Storage — set FILESYSTEM_DISK=s3 and fill AWS_* vars to use Cloudflare R2 (recommended for Railway).
# Leave FILESYSTEM_DISK=local when using a Railway Volume mounted at /var/www/html/storage/app/public.
FILESYSTEM_DISK=local
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=auto
#AWS_BUCKET=
#AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#AWS_URL=https://pub-<hash>.r2.dev
#AWS_USE_PATH_STYLE_ENDPOINT=true

CACHE_STORE=file
CACHE_PREFIX=

# Email — set MAIL_MAILER=smtp and fill all MAIL_* vars for production.
# MAIL_MAILER=log silently writes emails to the log file (dev only).
MAIL_MAILER=log
#MAIL_HOST=smtp.example.com
#MAIL_PORT=465
#MAIL_USERNAME=kontakt@certicars.pl
#MAIL_PASSWORD=
#MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=kontakt@certicars.pl
MAIL_FROM_NAME="CertiCars"

VITE_APP_NAME="${APP_NAME}"

# Admin panel credentials (required on production)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FORCE_PASSWORD_RESET=false
